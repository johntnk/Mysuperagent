{
  "name": "mysuperagent",
  "version": "0.2.0",
  "description": "A coordination agent for Feishu (Lark) groups: records feedback, assigns tasks with one owner, follows them through delivery and QA.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:acceptance": "vitest run --config vitest.config.ts tests/acceptance",
    "build": "wrangler deploy --dry-run --outdir dist",
    "demo": "tsx scripts/demo.ts",
    "replay:history": "node --use-env-proxy --import tsx scripts/history-replay.ts",
    "connector": "tsx connector/main.ts",
    "check:config": "tsx scripts/check-config.ts",
    "preflight:feishu": "tsx scripts/feishu-preflight.ts --read-only",
    "prepare:deployment": "tsx scripts/prepare-deployment.ts",
    "check": "npm run typecheck && npm test && npm run test:workers",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "agents": "0.33.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
