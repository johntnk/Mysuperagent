{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["@cloudflare/workers-types", "node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src", "connector", "scripts", "tests", "vitest*.ts"]
}
